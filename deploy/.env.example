# ZIPI production settings. Copy to .env (never commit the real file) and fill in.
NODE_ENV=production
PORT=3000
APP_TZ=Asia/Kolkata
PUBLIC_URL=https://zipi.example.com

# PostgreSQL 14+ (managed: AWS RDS, DigitalOcean, Supabase, Neon, Google Cloud SQL)
DATABASE_URL=postgres://zipi:CHANGE_ME@db.example.com:5432/zipi
DB_POOL_SIZE=20          # per worker process; keep workers x pool below the database's max_connections
DB_SSL=1
WEB_CONCURRENCY=4        # worker processes per server (default: number of CPU cores)

# Secrets: generate each with  openssl rand -hex 32  and use the SAME values on every server.
# Losing ZIPI_DATA_KEY makes encrypted ID/bank details unreadable: store it in a password manager / secrets vault.
ZIPI_SECRET=
ZIPI_DATA_KEY=

# Login SMS. Fill in at least one service. If you set several, they are tried in this order and the next is used when one fails.
# Check with: node scripts/zipi.js sms-status   and   node scripts/zipi.js test-sms <your mobile>
SMS_PROVIDERS=sns,msg91

# Twilio (console.twilio.com). Recommended: an API key instead of the main Auth Token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Twilio Verify (recommended for India): Verify > Services > create one with code length 6, then paste its VA... SID
TWILIO_VERIFY_SERVICE_SID=
# Twilio Messages (optional fallback): ZIPI writes the SMS. Indian numbers need a DLT-registered sender ID.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_NUMBER=

# AWS SNS (IAM user limited by deploy/aws-sns-policy.json). India needs DLT sender ID, entity ID and template ID.
SNS_ACCESS_KEY_ID=
SNS_SECRET_ACCESS_KEY=
SNS_REGION=ap-south-1
SNS_SENDER_ID=
SNS_DLT_ENTITY_ID=
SNS_DLT_TEMPLATE_ID=

# Wording for SMS that ZIPI writes (sns, twilio). Must match the DLT template exactly. {code} and {minutes} are filled in.
SMS_TEXT={code} is your ZIPI login code. Valid for {minutes} minutes. Do not share it.

# MSG91 OTP API with a DLT-approved template that contains ##OTP##
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Never 1 in production: it would show login codes on screen
ZIPI_DEV_OTP=0

# Behind Nginx / a load balancer
ZIPI_TRUST_PROXY=1

# Maps: run your own servers for production traffic (see DEPLOY.md)
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
MAPS_USER_AGENT=ZIPI-delivery/2.0 (ops@yourcompany.in)

# Uploaded files: s3 for more than one server (AWS S3, DigitalOcean Spaces, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Monitoring: GET /metrics with  Authorization: Bearer <token>
METRICS_TOKEN=
LOG_LEVEL=info

# Retention
HISTORY_DAYS=90
EVENT_DAYS=180
APP_BACKUPS=1            # also write the app's own daily backup file (in addition to your database provider's backups)
